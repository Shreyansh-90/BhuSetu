# =============================================================================
# BhuSetu Environment Variables Template
# Copy this file to .env.local and fill in your values
# =============================================================================

# --- Supabase (Public / Client) ---
# For Local Supabase: http://127.0.0.1:54321
# For Supabase Cloud: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (Server-only Admin) ---
# Service role key with administrative privileges (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database Connection (PostgreSQL with PostGIS) ---
# For Local Supabase: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# For Supabase Cloud: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- MinIO Object Storage (Private S3-compatible storage) ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=bhu-setu

# --- App Environment ---
NODE_ENV=development
=======
# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy Supabase client key expected by the current code.
# Supabase now recommends the publishable key for new projects; migrate the
# variable name in the application before switching this value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-or-publishable-key

# PostgreSQL connection string used by Drizzle. Server-only.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Legacy elevated Supabase key expected by the current admin client. Server-only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# MinIO is intentionally omitted while storage integration is paused.
