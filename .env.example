# Supabase project URL. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Legacy Supabase client key expected by the current code.
# Supabase now recommends the publishable key for new projects; migrate the
# variable name in the application before switching this value.
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-your-anon-or-publishable-key

# PostgreSQL connection string used by Drizzle. Server-only.
DATABASE_URL=postgresql://postgres:password@db.your-project-ref.supabase.co:5432/postgres

# Legacy elevated Supabase key expected by the current admin client. Server-only.
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# MinIO is intentionally omitted while storage integration is paused.
# When enabled, provide all three required values together:
# MINIO_ENDPOINT=localhost
# MINIO_PORT=9000
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=replace-with-minio-access-key
# MINIO_SECRET_KEY=replace-with-minio-secret-key
# MINIO_BUCKET=bhu-setu

# Mapbox GL JS public token. Safe to expose to the browser.
# Obtain from https://account.mapbox.com — restrict to your domain in production.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.your-public-mapbox-token-here
